# Neon Database URL
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# 32-byte hex encryption key for AES-256-GCM
ENCRYPTION_KEY=""

# NextAuth Configuration
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# AI Platform Fallback Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
