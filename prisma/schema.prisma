datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum Role {
  PLATFORM_OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  LOCAL
  OTHER
}

enum Channel {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEBCHAT
  IMESSAGE
  SMS
  EMAIL
}

enum ConversationStatus {
  OPEN
  CLOSED
  PENDING
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  LOCATION
  OTHER
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum SenderType {
  CUSTOMER
  BOT
  AGENT
}

enum LeadStatus {
  NEW
  QUALIFIED
  APPLICATION_CAPTURED
  HANDED_OFF
  NEGOTIATION
  CONVERTED
  LOST
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
}

enum PolicyStatus {
  ACTIVE
  LAPSED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
  FAILED
  PAUSED
  CANCELLED
}

enum BroadcastJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED_OPTED_OUT
}

enum ReminderType {
  RENEWAL
  CROSS_SELL
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
}

enum WhatsAppNumberStatus {
  CONNECTED
  DISCONNECTED
  QR_PENDING
}

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  status             String   @default("ACTIVE")
  isDraft            Boolean  @default(false)
  subscriptionPlan   String
  subscriptionStatus String
  createdAt          DateTime @default(now())

  // Visual Branding & Landing Page fields
  logoUrl            String?
  primaryColor       String?  @default("#004ac6")
  secondaryColor     String?  @default("#737686")
  heroTagline        String?
  heroDescription    String?
  trustBadges        Json?    // Array of { icon: string, text: string }
  contactEmail       String?
  contactPhone       String?
  businessHours      String?
  socialLinks        Json?    // Array of { platform: string, url: string }

  // Relations
  users                User[]
  tenantAIConfig       TenantAIConfig?
  customers            Customer[]
  customerChannels     CustomerChannel[]
  conversations        Conversation[]
  messages             Message[]
  leads                Lead[]
  applications         Application[]
  policies             Policy[]
  policyCatalogItems   PolicyCatalogItem[]
  policyDocumentChunks PolicyDocumentChunk[]
  broadcastCampaigns   BroadcastCampaign[]
  broadcastJobs        BroadcastJob[]
  reminderJobs         ReminderJob[]
  whatsAppNumber       WhatsAppNumber?
  instagramAccount     InstagramAccount?
  templates            Template[]
  auditLogs            AuditLog[]
  botConfig            BotConfig?
  tenantAnnouncements  TenantAnnouncement[]
  tokenUsageLogs       TokenUsageLog[]
  onboardingProgress   TenantOnboardingProgress?
  intakeFlow           IntakeFlow?
  customerNotes        CustomerNote[]
  escalationLogs       EscalationLog[]
  marketingCampaigns   MarketingCampaign[]
  platformConnections  PlatformConnection[]
  intakeSessions       IntakeSession[]
  inboundMessageJobs   InboundMessageJob[]
  dynamicIntakeQuestions DynamicIntakeQuestion[]
  tenantEmailConfig    TenantEmailConfig?
  tenantSendingDomains TenantSendingDomain[]
  globalSuppressions   GlobalSuppression[]
  emailEvents          EmailEvent[]
  crossChannelJourneys CrossChannelJourney[]
  journeyEnrollments   JourneyEnrollment[]
}

model BotConfig {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  name          String
  greetingMessage String
  stopKeyword   String?  @default("STOP")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model User {
  id                String   @id @default(cuid())
  tenantId          String?
  email             String   @unique
  hashedPassword    String
  role              Role
  totpSecret        String?
  twoFactorEnabled  Boolean  @default(false)
  createdAt         DateTime @default(now())

  // Relations
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  leads         Lead[]
  policies      Policy[]
  auditLogs     AuditLog[]
  customerNotes CustomerNote[]

  @@index([tenantId])
}

model TenantAIConfig {
  id              String     @id @default(cuid())
  tenantId        String     @unique
  provider        AIProvider
  encryptedApiKey String
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Customer {
  id             String    @id @default(cuid())
  tenantId       String
  displayName    String
  primaryPhone   String // Encrypted, verified via OTP (canonical key)
  activePolicyId String? // optional foreign key to Policy
  activePolicy   Policy? @relation("ActivePolicy", fields: [activePolicyId], references: [id])
  tags           String[]  @default([])
  location       String?

  otpVerified    Boolean   @default(false)
  otpCode        String?
  email          String?
  optedIn        Boolean   @default(false)
  optedInAt      DateTime?
  optedOutAt     DateTime?
  emailConsentStatus String  @default("SUBSCRIBED") // SUBSCRIBED, UNSUBSCRIBED, PENDING, BOUNCED, COMPLAINED
  emailConsentSource String?
  emailConsentTimestamp DateTime?
  consentIp      String?
  consentTimestamp DateTime?
  primaryCustomerId String? // Optional parent customer for dependent phone resolution
  createdAt      DateTime  @default(now())

  // Relations
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryCustomer  Customer?         @relation("CustomerDependents", fields: [primaryCustomerId], references: [id], onDelete: SetNull)
  dependents       Customer[]        @relation("CustomerDependents")
  customerChannels CustomerChannel[]
  conversations    Conversation[]
  leads            Lead[]
  applications     Application[]
  policies         Policy[]
  broadcastJobs    BroadcastJob[]
  notes            CustomerNote[]
  intakeSessions   IntakeSession[]
  emailEvents        EmailEvent[]
  journeyEnrollments JourneyEnrollment[]

  @@index([tenantId])
  @@index([primaryPhone])
}

model CustomerChannel {
  id                String  @id @default(cuid())
  tenantId          String
  customerId        String
  channel           Channel
  channelIdentifier String
  channelMetadata   Json

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

model Conversation {
  id                String             @id @default(cuid())
  tenantId          String
  customerId        String
  channel           Channel
  status            ConversationStatus @default(OPEN)
  assignedAgentId   String?
  needsEscalation   Boolean            @default(false)
  escalationReason  String?
  automationEnabled Boolean            @default(true)
  lastMessageAt     DateTime           @default(now())
  createdAt         DateTime           @default(now())

  // Relations
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent User?     @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([tenantId])
  @@index([customerId])
  @@index([assignedAgentId])
}

model Message {
  id                String           @id @default(cuid())
  tenantId          String
  conversationId    String
  direction         MessageDirection
  senderType        SenderType
  content           String           @db.Text
  mediaUrl          String?
  channel           Channel
  channelMessageId  String?
  messageType       MessageType      @default(TEXT)
  status            MessageStatus    @default(SENT)
  clientMessageId   String?          @unique
  providerMessageId String?
  mediaId           String?
  contextMessageId  String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime         @default(now())

  // Relations
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
}

model Lead {
  id                     String     @id @default(cuid())
  tenantId               String
  customerId             String
  status                 LeadStatus @default(NEW)
  lostReason             String?
  intakeAnswers          Json?
  source                 String
  campaignId             String?
  intakeAge              Int?
  intakeState            String?
  intakeHealthConditions Json?
  intakeBudgetMin        Int? // cents
  intakeBudgetMax        Int? // cents
  intakeFamilySize       Int?
  recommendedPolicyIds   String[]
  selectedPolicyId       String?
  assignedAgentId        String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  // Relations
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent User?         @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  applications  Application[]
  intakeSession IntakeSession?

  @@index([tenantId])
  @@index([customerId])
  @@index([assignedAgentId])
}

model Application {
  id              String            @id @default(cuid())
  tenantId        String
  leadId          String
  customerId      String
  applicationData String            @db.Text // Encrypted (PII)
  capturedAt      DateTime          @default(now())
  status          ApplicationStatus @default(DRAFT)

  // Relations
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policy   Policy?

  @@index([tenantId])
  @@index([leadId])
  @@index([customerId])
}

model Policy {
  id                String       @id @default(cuid())
  tenantId          String
  customerId        String
  applicationId     String?      @unique
  policyCatalogId   String
  policyNumber      String
  effectiveDate     DateTime
  expiryDate        DateTime
  status            PolicyStatus @default(ACTIVE)
  confirmedByUserId String
  createdAt         DateTime     @default(now())

  // Relations
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  application     Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  policyCatalog   PolicyCatalogItem   @relation(fields: [policyCatalogId], references: [id])
  confirmedByUser User                @relation(fields: [confirmedByUserId], references: [id])
  reminderJobs    ReminderJob[]
  activeCustomers Customer[] @relation("ActivePolicy")
  documentChunks  PolicyDocumentChunk[]

  @@index([tenantId])
  @@index([customerId])
  @@index([policyCatalogId])
  @@index([confirmedByUserId])
}

model PolicyCatalogItem {
  id               String   @id @default(cuid())
  tenantId         String
  policyId         String // internal unique code
  name             String
  insurerName      String
  states           String[]
  premiumMin       Int // cents
  premiumMax       Int // cents
  sumInsured       Int // cents
  active           Boolean  @default(true)
  extractedSummary String   @db.Text
  pdfUrl           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policies       Policy[]
  documentChunks PolicyDocumentChunk[]

  @@index([tenantId])
  @@index([policyId])
}

model PolicyDocumentChunk {
  id               String   @id @default(cuid())
  tenantId         String
  policyCatalogId  String?
  policyId         String?
  chunkText        String   @db.Text
  pageNumber       Int
  pineconeVectorId String
  createdAt        DateTime @default(now())

  // Relations
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyCatalog PolicyCatalogItem? @relation(fields: [policyCatalogId], references: [id], onDelete: Cascade)
  policy        Policy?            @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([policyCatalogId])
  @@index([policyId])
}

model BroadcastCampaign {
  id              String         @id @default(cuid())
  tenantId        String
  name            String
  messageTemplate String         @default("") @db.Text // keep for compatibility
  templateId      String?
  recipientFilter Json?
  channel         Channel        @default(WHATSAPP)
  subject         String?
  previewText     String?
  senderName      String?
  senderEmail     String?
  replyTo         String?
  scheduledAt     DateTime?
  status          CampaignStatus @default(DRAFT)
  // A/B Testing Configuration
  isAbTest        Boolean        @default(false)
  abSubjectB      String?
  abSenderNameB   String?
  abTemplateIdB   String?
  abTestSplit     Int?           @default(50)   // e.g. 50/50 test split percentage
  abWinnerMetric  String?        @default("CLICKS") // "CLICKS" | "OPENS"
  abDurationHours Int?           @default(4)
  abWinnerSelected String?       // "A" | "B" | null
  sent            Int            @default(0)
  delivered       Int            @default(0)
  read            Int            @default(0)
  replied         Int            @default(0)
  converted       Int            @default(0)
  failed          Int            @default(0)
  optedOut        Int            @default(0)
  cost            Float          @default(0.0)
  createdAt       DateTime       @default(now())

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template      Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  broadcastJobs BroadcastJob[]
  emailEvents   EmailEvent[]

  @@index([tenantId])
  @@index([templateId])
  @@index([channel])
}

model BroadcastJob {
  id           String             @id @default(cuid())
  tenantId     String
  campaignId   String
  customerId   String
  status       BroadcastJobStatus @default(PENDING)
  attempts     Int                @default(0)
  lastError    String?
  scheduledFor DateTime
  processedAt  DateTime?

  // Relations
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([campaignId])
  @@index([customerId])
  @@index([status, scheduledFor])
}

model ReminderJob {
  id           String         @id @default(cuid())
  tenantId     String
  policyId     String
  reminderType ReminderType
  triggerDate  DateTime
  status       ReminderStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([policyId])
}

model WhatsAppNumber {
  id              String               @id @default(cuid())
  tenantId        String               @unique
  sessionData     String               @db.Text // Encrypted credentials
  status          WhatsAppNumberStatus @default(DISCONNECTED)
  lastConnectedAt DateTime?
  phoneNumber     String? // Encrypted
  qualityRating   String? // green/yellow/red quality indicator
  provider        String               @default("BAILEYS") // "BAILEYS" | "META_CLOUD_API"
  metaPhoneNumberId String?
  metaWabaId        String?
  metaAccessToken   String?            @db.Text
  metaVerifyToken   String?

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InstagramAccount {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  instagramId        String    // Instagram Business Account ID
  username           String?   // e.g. @your_brand
  pageId             String    // Connected Facebook Page ID
  pageAccessToken    String    @db.Text // Encrypted Page Access Token
  tokenExpiresAt     DateTime?
  status             String    @default("CONNECTED")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([instagramId])
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model Template {
  id                 String              @id @default(cuid())
  tenantId           String
  name               String
  category           TemplateCategory    @default(MARKETING)
  language           String              @default("en")
  body               String              @default("") @db.Text
  content            String              @default("") @db.Text // keep for backwards compatibility
  header             String?             @db.Text
  footer             String?             @db.Text
  ctaButtons         Json?               // JSON array of CTA buttons: [{ type: 'QUICK_REPLY' | 'URL' | 'PHONE', text: string, url?: string, phoneNumber?: string }]
  channel            Channel             @default(WHATSAPP)
  subject            String?
  previewText        String?
  htmlBody           String?             @db.Text
  plainText          String?             @db.Text
  jsonDesign         Json?               // Visual block-based editor representation
  status             TemplateStatus      @default(DRAFT)
  createdAt          DateTime            @default(now())

  // Relations
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  broadcastCampaigns BroadcastCampaign[]

  @@index([tenantId])
  @@index([channel])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model TenantAnnouncement {
  id        String   @id @default(cuid())
  tenantId  String
  message   String
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TokenUsageLog {
  id           String   @id @default(cuid())
  tenantId     String
  inputTokens  Int
  outputTokens Int
  cost         Float
  timestamp    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model PlanRateLimit {
  id        String  @id @default(cuid())
  plan      String  @unique // FREE, STARTUP, GROWTH, ENTERPRISE
  maxTokens Float
  hardStop  Boolean @default(true)
}

model TenantOnboardingProgress {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  accountCreated    Boolean  @default(true)
  whatsappConnected Boolean  @default(false)
  botNameSet        Boolean  @default(false)
  intakeFlowBuilt   Boolean  @default(false)
  productAdded      Boolean  @default(false)
  agentInvited      Boolean  @default(false)
  testMessageSent   Boolean  @default(false)
  goneLive          Boolean  @default(false)
  onboardingDismissed Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model IntakeFlow {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  questions Json     // JSON array of question nodes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  userId     String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([userId])
}

model EscalationLog {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String?
  customerId     String?
  userQuestion   String   @db.Text
  reason         String?
  triggeredAt    DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([triggeredAt])
}

enum MarketingCampaignType {
  ORGANIC
  PAID
}

enum MarketingCampaignStatus {
  DRAFT
  SCHEDULED
  PENDING
  PUBLISHING
  SUCCESS
  FAILED
}

enum CtrPrediction {
  LOW
  MEDIUM
  HIGH
}

enum PreFlightAuditVerdict {
  PASS
  REVIEW
  BLOCK
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  YOUTUBE
  META_ADS
}

enum PlatformConnectionStatus {
  CONNECTED
  NOT_CONNECTED
}

model MarketingCampaign {
  id                String                  @id @default(cuid())
  tenantId          String
  name              String
  type              MarketingCampaignType   @default(ORGANIC)
  platforms         String[]                // e.g. ["facebook", "instagram", "linkedin", "youtube"]
  mediaUrl          String?
  caption           String                  @db.Text
  status            MarketingCampaignStatus @default(DRAFT)
  scheduledAt       DateTime?
  publishedAt       DateTime?
  reach             Int                     @default(0)
  budget            Float?                  // for paid ads
  audienceTargeting Json?                   // { ageRange: string, location: string, interests: string[] }
  complianceScore   Int?                    // 0-100
  ctrPrediction     CtrPrediction?
  auditResult       PreFlightAuditVerdict?
  auditDetails      Json?                   // checklist & recommendations
  abTestVariantOfId String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  abTestVariantOf MarketingCampaign?  @relation("ABTestVariants", fields: [abTestVariantOfId], references: [id], onDelete: SetNull)
  abTestVariants  MarketingCampaign[] @relation("ABTestVariants")

  @@index([tenantId])
  @@index([abTestVariantOfId])
  @@index([status])
}

model PlatformConnection {
  id          String                   @id @default(cuid())
  tenantId    String
  platform    SocialPlatform
  status      PlatformConnectionStatus @default(NOT_CONNECTED)
  accountName String?
  accessToken String?                  @db.Text
  connectedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([tenantId, platform])
}

enum IntakeSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model IntakeSession {
  id                String              @id @default(cuid())
  tenantId          String
  leadId            String              @unique
  customerId        String
  flowId            String
  flowVersion       String
  status            IntakeSessionStatus @default(IN_PROGRESS)
  currentFieldKey   String?             // Active question fieldKey being asked
  interruptionCount Int                 @default(0)
  isComplete        Boolean             @default(false)
  collectedFields   Json
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  completedAt       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leadId])
  @@index([customerId])
}

enum InboundJobStatus {
  RECEIVED
  QUEUED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model InboundMessageJob {
  id             String           @id @default(cuid())
  tenantId       String
  wamId          String?          // Meta WhatsApp Message ID (for atomic idempotency)
  senderPhone    String?          // Normalized E.164 phone
  recipientId    String?          // WhatsApp Business Account Phone ID
  payload        Json?            // Raw webhook payload
  conversationId String?
  messageId      String?          @unique
  status         InboundJobStatus @default(RECEIVED)
  attempts       Int              @default(0)
  maxAttempts    Int              @default(3)
  lastError      String?
  lockedAt       DateTime?        // Row lock timestamp for stale lock resolution
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  processedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, wamId])     // DB-level unique constraint for atomic deduplication
  @@index([tenantId])
  @@index([status, createdAt])
}

enum ValidationType {
  NUMBER
  US_STATE
  CURRENCY
  ENUM
  PHONE
  EMAIL
  DATE
  TEXT
}

model DynamicIntakeQuestion {
  id              String         @id @default(cuid())
  tenantId        String
  stepOrder       Int
  fieldKey        String         // "age", "state", "budget", "family_size", "conditions"
  questionPrompt  String         @db.Text
  validationType  ValidationType @default(TEXT)
  isMandatory     Boolean        @default(true)
  isSkippable     Boolean        @default(false)
  options         Json?          // Array of quick-reply choices for WhatsApp buttons
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stepOrder])
  @@unique([tenantId, fieldKey])
  @@index([tenantId, isActive])
}

model TenantEmailConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  provider        String   @default("RESEND") // "RESEND" | "SES" | "SENDGRID" | "SMTP"
  encryptedApiKey String   @db.Text           // Encrypted with AES-256-GCM
  fromName        String                      // e.g. "Apex Insurance"
  fromEmail       String                      // e.g. "care@apexinsurance.com"
  replyToEmail    String?
  dailySendQuota  Int      @default(1000)
  hourlySendRate  Int      @default(100)      // For IP/domain warm-up pacing
  complaintRate   Float    @default(0.0)      // Percentage of complaints (warn at 0.1%, pause at 0.3%)
  isAutoPaused    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantSendingDomain {
  id          String    @id @default(cuid())
  tenantId    String
  domain      String                          // e.g. "apexinsurance.com"
  status      String    @default("PENDING")   // "PENDING" | "VERIFIED" | "FAILED"
  spfRecord   Json?                           // { type: "TXT", host: "@", value: "v=spf1 ...", status: "VALID" }
  dkimRecords Json?                           // Array of { type: "CNAME", host: "resend._domainkey", value: "...", status: "VALID" }
  dmarcRecord Json?                           // { type: "TXT", host: "_dmarc", value: "v=DMARC1; ...", status: "VALID" }
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, domain])
  @@index([tenantId])
}

model GlobalSuppression {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  reason    String                            // "HARD_BOUNCE" | "COMPLAINT" | "MANUAL_UNSUBSCRIBE" | "ADMIN_SUPPRESSED"
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, email])
}

enum EmailEventType {
  DELIVERED
  OPEN
  CLICK
  BOUNCE_HARD
  BOUNCE_SOFT
  COMPLAINT
  UNSUBSCRIBE
}

model EmailEvent {
  id         String         @id @default(cuid())
  tenantId   String
  customerId String?
  campaignId String?
  messageId  String?        // Provider message ID
  email      String
  eventType  EmailEventType
  url        String?        // Clicked link target
  ipAddress  String?
  userAgent  String?
  metadata   Json?          // Raw webhook data
  createdAt  DateTime       @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  campaign  BroadcastCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@index([campaignId])
  @@index([email])
  @@index([eventType])
  @@index([messageId])
  @@index([createdAt])
}

enum JourneyTriggerType {
  CONTACT_CREATED
  TAG_ADDED
  FORM_SUBMITTED
  EMAIL_LINK_CLICKED
  WHATSAPP_UNREAD_TIMEOUT
  CUSTOM_WEBHOOK
}

enum JourneyStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum JourneyEnrollmentStatus {
  IN_PROGRESS
  COMPLETED
  EXITED_UNSUBSCRIBED
  EXITED_CONVERTED
  EXITED_REPLIED
}

model CrossChannelJourney {
  id               String             @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  triggerType      JourneyTriggerType @default(CONTACT_CREATED)
  triggerConfig    Json?              // e.g. { tag: "VIP", timeoutHours: 24, formId: "quote-form" }
  status           JourneyStatus      @default(DRAFT)
  steps            Json               // Ordered steps: [{ id, type, channel, templateId, delayHours, condition }]
  frequencyCapDays Int                @default(1) // Max 1 message per contact across all channels per X days
  quietHoursStart  String?            @default("21:00") // e.g. "21:00"
  quietHoursEnd    String?            @default("08:00") // e.g. "08:00"
  exitConditions   Json?              // e.g. ["REPLIED", "CONVERTED", "UNSUBSCRIBED"]
  enrolledCount    Int                @default(0)
  completedCount   Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments JourneyEnrollment[]

  @@index([tenantId])
  @@index([status])
}

model JourneyEnrollment {
  id               String                  @id @default(cuid())
  tenantId         String
  journeyId        String
  customerId       String
  currentStepIndex Int                     @default(0)
  status           JourneyEnrollmentStatus @default(IN_PROGRESS)
  nextExecutionAt  DateTime?               @default(now())
  lastContactedAt  DateTime?
  logs             Json?                   // [{ stepIndex, channel, executedAt, status, details }]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journey  CrossChannelJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([journeyId, customerId])
  @@index([tenantId])
  @@index([journeyId])
  @@index([customerId])
  @@index([status])
  @@index([nextExecutionAt])
}
